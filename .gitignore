node_modules

# `node_modules` has no trailing slash on purpose. A trailing slash matches only directories, and a
# worktree provisioned with a symlinked dependency tree produces a FILE — which then sits untracked
# and visible, one `git add -A` away from committing a path specific to one machine.

# Build output and tool artefacts. Generated code is not source and must not be reviewed as if it
# were — the marker this replaces said exactly that.
dist
coverage
.vite
*.tsbuildinfo
test-results
playwright-report
blob-report
